[numthreads(64,1,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    float3 vert1 = mul(_local2World, float4(trisInfo[id.x].vert1,1));
    float3 vert2 = mul(_local2World, float4(trisInfo[id.x].vert2,1));
    float3 vert3 = mul(_local2World, float4(trisInfo[id.x].vert3,1));
    float3 leftDownPos = _center - _extents;
    float3 upperTopPos = _center + _extents;
    // float2 forwardUV = (vert1.xy - leftDownPos.xy) / _extents.xy*_density;
    // float2 downUV = ()
    ForwardUV(vert1,vert2,vert3,leftDownPos);
    BackwardUV(vert1,vert2,vert3,leftDownPos);
    LeftUV(vert1,vert2,vert3,leftDownPos);
}

